{
  "candidate_id": {
    "type": "string",
    "required": true,
    "description": "Unique identifier of the candidate."
  },
  "job_id": {
    "type": "string",
    "required": true,
    "description": "Unique identifier of the job."
  },
  "question_id": {
    "type": "string",
    "required": true,
    "description": "Unique identifier of the screening question."
  },
  "timestamp": {
    "type": "ISO-8601 datetime",
    "required": true,
    "description": "Time at which the transcript interaction was recorded."
  },
  "confidence_level": {
    "type": "float",
    "range": "0.0-1.0",
    "required": true,
    "description": "Speech-to-text confidence level for the transcript segment."
  },
  "speaker": {
    "type": "enum",
    "values": [
      "candidate",
      "interviewer",
      "system"
    ],
    "required": true,
    "description": "Source of the transcript segment."
  },
  "sequence": {
    "type": "integer",
    "required": true,
    "description": "Order of the transcript segment in the conversation."
  },
  "text": {
    "type": "string",
    "required": true,
    "description": "Normalized transcript text."
  },
  "language": {
    "type": "string",
    "required": true,
    "description": "Language of the transcript segment."
  }
}