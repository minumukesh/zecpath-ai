{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zecpath Resume Schema",
  "description": "Standard structured schema for candidate resumes",
  "type": "object",
  "required": [
    "candidate_id",
    "name",
    "email",
    "skills",
    "education",
    "experience",
    "certifications",
    "projects"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "degree",
          "institution",
          "year"
        ],
        "properties": {
          "degree": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "designation",
          "company",
          "years",
          "description"
        ],
        "properties": {
          "designation": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "years": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "issuer"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "technologies"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
