{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zecpath Job Description Schema",
  "description": "Standard structured schema for job descriptions",
  "type": "object",
  "required": [
    "job_id",
    "job_title",
    "company",
    "location",
    "employment_type",
    "description",
    "required_skills",
    "preferred_skills",
    "experience",
    "education",
    "responsibilities",
    "certifications"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Full-time",
        "Part-time",
        "Contract",
        "Internship",
        "Temporary"
      ]
    },
    "description": {
      "type": "string"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience": {
      "type": "object",
      "required": [
        "minimum_years",
        "maximum_years"
      ],
      "properties": {
        "minimum_years": {
          "type": "number"
        },
        "maximum_years": {
          "type": "number"
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
